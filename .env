# OpenAI Configuration
OPENAI_API_KEY=${OPENAI_API_KEY}

# Database Configuration (Using SQLite for simplicity in sandbox)
DATABASE_URL=file:./sqlite.db

# OAuth/Authentication Configuration (Placeholder for sandbox)
OAUTH_CLIENT_ID=placeholder_client_id
OAUTH_CLIENT_SECRET=placeholder_client_secret
OAUTH_REDIRECT_URL=http://localhost:5000/api/auth/callback

# Server Configuration
NODE_ENV=development
PORT=5000

# Session Configuration
SESSION_SECRET=a_very_secret_key_for_svu_ai_studio

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Frontend Configuration
VITE_API_URL=http://localhost:5000
VITE_APP_NAME=Svu Ai Studio

